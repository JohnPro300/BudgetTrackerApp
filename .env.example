# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost/budget_tracker

# JWT
JWT_SECRET=Generated secret for JWT tokens
JWT_REFRESH_SECRET=Generated secret for JWT refresh tokens
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

#  Email (SMTP) — Gmail example 
# 1. Go to myaccount.google.com > Security > 2-Step Verification > App Passwords
# 2. Generate a 16-character App Password for "Mail"
# 3. Paste it as EMAIL_PASS below
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail_address_here
EMAIL_PASS=your_generated_app_password_here
EMAIL_FROM="Budget Tracker<your_gmail_address_here>"
